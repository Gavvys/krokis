{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krokis",
  "version": "0.2.0",
  "identifier": "com.krokis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Krokis",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
